# Run evidence: reproducible, unbounded, and may contain response bodies
# from whatever API the server was pointed at. Never tracked.
evidence/
evidence-*/
node_modules/
.env

# Machine-local session context, never shipped
CLAUDE.local.md

# Fleet run artifacts (wire logs, snapshots, repo diffs, feedback): per machine, never tracked
results/

# generated by `map .` when no --out is given; never track a render artifact
api-footprint.html

# Private alpha bundles generated locally, never source inputs
/dist/

# Machine-local generated artifacts, never source inputs
/output/
/lib/build-info.json
