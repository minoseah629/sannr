{
  "info": {
    "name": "Renamed auth header",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "custom auth header name carries a bearer token",
      "request": {
        "method": "GET",
        "url": "https://api.example.test/v1/me",
        "header": [
          {
            "key": "X-Session",
            "value": "Bearer ROB1_AUTH_VALUE_7f4d9a"
          },
          {
            "key": "Authorizati\u00f8n",
            "value": "Basic Uk9CMV9BVVRIX1ZBTFVFXzZjMmI6c2VjcmV0"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('ok', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
